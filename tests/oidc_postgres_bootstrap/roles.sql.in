CREATE ROLE "@OWNER@" NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE "@APP@" NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE "@OBSERVER@" NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE DATABASE "@DATABASE@" OWNER "@BOOTSTRAP@" TEMPLATE template0;
REVOKE ALL PRIVILEGES ON DATABASE "@DATABASE@" FROM PUBLIC;
GRANT CONNECT ON DATABASE "@DATABASE@" TO "@OWNER@","@APP@","@OBSERVER@";
\connect "@DATABASE@" "@BOOTSTRAP@" "@ROOT@/run" 5432
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO "@OWNER@","@APP@","@OBSERVER@";
GRANT CREATE ON SCHEMA public TO "@OWNER@";
