data_directory = '@ROOT@/pgdata'
port = 5432
unix_socket_directories = '@ROOT@/run'
unix_socket_permissions = 0700
cluster_name = '@CLUSTER@'
password_encryption = 'scram-sha-256'
logging_collector = on
log_directory = '@ROOT@/log'
log_statement = 'none'
log_min_error_statement = panic
log_error_verbosity = terse
log_parameter_max_length_on_error = 0
max_connections = 12
shared_buffers = '32MB'
work_mem = '1MB'
maintenance_work_mem = '16MB'
min_wal_size = '32MB'
max_wal_size = '64MB'
temp_file_limit = 32768
temp_tablespaces = ''
fsync = on
synchronous_commit = on
full_page_writes = on
listen_addresses = '@SERVER@'
hba_file = '@ROOT@/work/pg_hba.tls.conf'
ssl = on
ssl_cert_file = '@ROOT@/tls/server.crt'
ssl_key_file = '@ROOT@/tls/server.key'
ssl_ca_file = '@ROOT@/tls/ca.crt'
ssl_min_protocol_version = 'TLSv1.2'
